# Copy to .env and edit. Never commit the real .env file.
SHADOW_SECRET_KEY=replace-with-a-long-random-string
SHADOW_ADMIN_USERNAME=admin
SHADOW_ADMIN_PASSWORD=replace-with-a-strong-password
SHADOW_BASE_URL=http://127.0.0.1:8000
SHADOW_HOST=127.0.0.1
SHADOW_PORT=8000
SHADOW_THREADS=8

# Set to 1 only when the site is served over HTTPS.
SHADOW_COOKIE_SECURE=0
SHADOW_FORCE_HTTPS=0

# Optional paths (defaults are relative to this project folder)
# SHADOW_DB_PATH=data/shadow_download.db
# SHADOW_STORAGE_PATH=storage
# SHADOW_MAX_UPLOAD_MB=2048

# Only needed for tools/export_static.py (free GitHub Pages deployment)
# SHADOW_PUBLIC_BASE_URL=https://your-account.github.io/shadow-download/
# SHADOW_STATIC_RELEASE_URL_TEMPLATE=https://github.com/your-account/shadow-download/releases/download/v{version}/{filename}
